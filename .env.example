# --- SMTP credentials (used to SEND daily reminder + completion emails) ---
# Gmail example: host smtp.gmail.com, port 587, and an "App Password" (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# Default address reminders are sent to (can also be set/overridden from Settings page)
REMINDER_TO_EMAIL=your_email@gmail.com

# Public URL of your deployed app (used in email "Open Dashboard" button + cron script)
APP_URL=http://localhost:3000

# Optional shared secret to protect the /api/reminder endpoint from being triggered by anyone
CRON_SECRET=change_this_to_a_random_string
